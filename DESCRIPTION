Package: eDNA2IQI
Title: eDNA2IQI: A package to predict the Infaunal Quality Index (IQI) in benthic sediments from eDNA
Version: 2.4.7
Authors@R: c(
    person("Adam", "Wyness",  role = c("aut", "cre"), email = "adam.wyness@sams.ac.uk", comment = c(ORCID = "0000-0003-1202-6358"),
    person("Tom", "Wilding", role = "aut", email = "tom.wilding@sams.ac.uk"),comment = c(ORCID = "0000-0002-4946-4020")
    person("Stevie", "Brain", role = "aut", comment = c(ORCID = "0000-0001-8272-6996")),
